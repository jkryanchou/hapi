# syntax=docker/dockerfile:1
#
# hapi-runner image: runs `hapi runner start-sync` and spawns coding-agent
# sessions on behalf of the hub.  The image must have every agent CLI on PATH.
#
# ── Stage 1: install all workspace dependencies ──────────────────────────────
FROM oven/bun:1.3.14 AS deps
WORKDIR /app

COPY package.json bun.lock ./
COPY cli/package.json     cli/package.json
COPY hub/package.json     hub/package.json
COPY web/package.json     web/package.json
COPY shared/package.json  shared/package.json
COPY website/package.json website/package.json
COPY docs/package.json    docs/package.json

RUN bun install --frozen-lockfile

# ── Stage 2: runtime with Node.js + agent CLIs ───────────────────────────────
# oven/bun does not ship npm; install Node.js 22 via NodeSource so we can
# install agent CLIs as standard npm global packages.
FROM oven/bun:1.3.14 AS runtime
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
# Copy monorepo source (runner needs cli/ + shared/ + hub/ workspaces at runtime)
COPY . .

# ── Install coding-agent CLIs ─────────────────────────────────────────────────
# Each agent must be reachable by its bare command name on PATH.
# Authentication is done by mounting host credential dirs at runtime (see compose).

# Claude Code  (→ `claude` command)
RUN npm install -g @anthropic-ai/claude-code

# Codex        (→ `codex` command)
RUN npm install -g @openai/codex

# Gemini CLI   (→ `gemini` command)
RUN npm install -g @google/gemini-cli

# OpenCode     (→ `opencode` command)
RUN npm install -g opencode-ai 2>/dev/null || npm install -g opencode 2>/dev/null || true

# Cursor Agent CLI:
# Cursor is a desktop application; its CLI is not available as a standalone npm
# package.  If you need Cursor sessions, install the Cursor app on the host and
# bind-mount its binary, or set HAPI_CURSOR_PATH to the binary path.

# ── Runtime environment ───────────────────────────────────────────────────────
# Hub URL and shared token are injected at deploy time via docker-compose / .env
ENV HAPI_API_URL=http://hapi-hub:3006

# Runner state (runner.state.json, logs/) lives under HAPI_HOME.
# Workspace code that agents will work in is mounted at /workspace.
VOLUME ["/root/.hapi", "/workspace"]

# Use start-sync (foreground) so the container stays alive while the runner runs.
CMD ["bun", "cli/src/index.ts", "runner", "start-sync", "--workspace-root", "/workspace"]
