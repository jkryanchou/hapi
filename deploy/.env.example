# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
# Obtain from: Cloudflare dashboard → Zero Trust → Networks → Tunnels → hapi
#              → Add a replica (copies the eyJ… token)
# Or via API: GET /accounts/{account_id}/cfd_tunnel/{tunnel_id}/token
TUNNEL_TOKEN=eyJ...

# ── Hub authentication tokens ──────────────────────────────────────────────────
# These must match between each hub and its paired runner.
# Generate with: openssl rand -hex 32
# For the personal hub on first deploy: if migrating state from the SG box,
# read the existing token from ~/.hapi/settings.json and use it here instead
# so existing web/Telegram pairings continue to work.
PERSONAL_TOKEN=change-me-personal
WORK_TOKEN=change-me-work

# ── Incus runner reachability ─────────────────────────────────────────────────
# The runners are Incus (LXC) system containers, not Docker services. Each hub is
# published on this Incus bridge gateway IP so the runners can reach it via
# HAPI_API_URL (personal -> :3006, work -> :3007). Must match the incusbr0 gateway
# chosen in `incus admin init`. Used by both docker-compose.yml and bootstrap.sh.
INCUS_GW=10.236.0.1

# ── Agent credentials (provisioned INTO the Incus runners) ────────────────────
# These are NO LONGER docker-compose env vars. deploy/incus/bootstrap.sh pushes
# them into each runner container with `incus file push`:
#   - ~/.claude, ~/.gemini  → read-only static creds
#   - ~/.codex/auth.json    → Codex ChatGPT OAuth (auth_mode: chatgpt)
#   - ~/.local/share/opencode/auth.json → opencode GitHub Copilot auth
# So they just need to exist on the host ($HOME) when bootstrap.sh runs.
# Refresh codex by re-pushing auth.json after `codex login` (OAuth tokens expire).
