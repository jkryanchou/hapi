# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
# Obtain from: Cloudflare dashboard → Zero Trust → Networks → Tunnels → hapi
#              → Add a replica (copies the eyJ… token)
# Or via API: GET /accounts/{account_id}/cfd_tunnel/{tunnel_id}/token
TUNNEL_TOKEN=eyJ...

# ── Hub authentication token ───────────────────────────────────────────────────
# Single merged hub. This base token must match every runner's CLI_API_TOKEN.
# Keep the former personal hub's token value so existing web/Telegram pairings
# (carried over in the hapi-personal-data volume) keep working.
# Used by docker-compose.yml (hub) AND deploy/incus/bootstrap.sh (runners).
HAPI_TOKEN=change-me

# ── Telegram bot ───────────────────────────────────────────────────────────────
# One bot for the single hub (the former personal bot). From @BotFather.
TELEGRAM_BOT_TOKEN=...

# ── Incus runner reachability (swas-sg-bgp host only) ──────────────────────────
# The swas-sg-bgp runner reaches the hub at http://${INCUS_GW}:3006 over the
# incusbr0 bridge. Must match the gateway chosen in `incus admin init`. The
# devnode runner uses HAPI_API_URL=https://hapi.jkryanchou.com instead and
# ignores this.
INCUS_GW=10.195.198.1

# ── Agent credentials (NOT compose env vars) ──────────────────────────────────
# deploy/incus/bootstrap.sh pushes them into each runner via `incus file push`
# from the invoking host's $HOME:
#   ~/.claude, ~/.gemini                       → pushed recursively
#   ~/.codex/auth.json                         → Codex ChatGPT OAuth
#   ~/.local/share/opencode/auth.json          → opencode auth
# They must exist on whichever host runs bootstrap.sh. Refresh codex by
# re-pushing auth.json after `codex login` (OAuth tokens expire).
