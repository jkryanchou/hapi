# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
# Obtain from: Cloudflare dashboard → Zero Trust → Networks → Tunnels → hapi
#              → Add a replica (copies the eyJ… token)
# Or via API: GET /accounts/{account_id}/cfd_tunnel/{tunnel_id}/token
TUNNEL_TOKEN=eyJ...

# ── Hub authentication tokens ──────────────────────────────────────────────────
# These must match between each hub and its paired runner.
# Generate with: openssl rand -hex 32
# For the personal hub on first deploy: if migrating state from the SG box,
# read the existing token from ~/.hapi/settings.json and use it here instead
# so existing web/Telegram pairings continue to work.
PERSONAL_TOKEN=change-me-personal
WORK_TOKEN=change-me-work

# ── Host home directory (for credential bind-mounts) ──────────────────────────
# The user whose ~/.claude, ~/.codex, ~/.gemini, etc. hold the agent credentials.
# Runners mount these read-only so agents can authenticate without baking secrets
# into the image.
HOST_HOME=/home/admin

# ── Agent auth tokens ──────────────────────────────────────────────────────────
# Codex CLI uses ChatGPT OAuth tokens stored in ~/.codex/auth.json.
# Copy the full JSON content (single line) from your local machine:
#   jq -c . ~/.codex/auth.json
CODEX_AUTH_JSON={"auth_mode":"chatgpt",...}

# opencode GitHub Copilot auth — content of ~/.local/share/opencode/auth.json
OPENCODE_AUTH_JSON={"access_token":"...",...}

# ── Optional: explicit agent binary paths (if not on PATH) ────────────────────
# HAPI_CLAUDE_PATH=/usr/local/bin/claude
# HAPI_CODEX_PATH=/usr/local/bin/codex
